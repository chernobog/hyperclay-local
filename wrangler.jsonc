{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudgolem",
  "main": "src/worker/index.js",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "cloudgolem-storage"
    }
  ],
  "routes": [
    {
      "pattern": "golem.akhensetukh.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
